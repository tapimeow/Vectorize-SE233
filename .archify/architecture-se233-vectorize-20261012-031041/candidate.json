  "cards": [
    {
      "dot": "cyan",
      "title": "Startup & UI files",
      "items": [
        "Launcher: plain main() so the fat JAR starts JavaFX",
        "VectorizeApplication: builds zip service, coordinator, view, controller",
        "VectorizeView: controls, original ImageView, SVG WebView",
        "VectorizeController: events, Back/Next, cancel, export, presets"
      ]
    },
    {
      "dot": "emerald",
      "title": "Model files",
      "items": [
        "AppSession: list of ImageDocuments + selected index",
        "ImageDocument: one image, its settings, status, SVG",
        "VectorizationSettings: detail, color mode, count, background",
        "DetailLevel / ColorMode / ProcessingStatus enums"
      ]
    },
    {
      "dot": "violet",
      "title": "Concurrency",
      "items": [
        "ProcessingCoordinator: worker pool + single serial executor",
        "Every job is a JavaFX Task; results return on FX thread",
        "ProcessingPolicy decides which images may run in parallel",
        "cancelActive() cancels all running Tasks"
      ]
    },
    {
      "dot": "amber",
      "title": "Pipeline & I/O",
      "items": [
        "RasterPreprocessor uses BackgroundRemoval + ColorAnalysis",
        "AutoTraceVectorEngine runs autotrace CLI on a temp raster",
        "SvgValidationService rejects raster, script or empty SVG",
        "ExportService writes temp file then moves, no overwrite"
      ]
    },
    {
      "dot": "rose",
      "title": "Errors & tests",
      "items": [
        "ConversionException: shared checked failure type",
        "13 JUnit test files: pipeline, import/ZIP, export, policy, UI",
        "JUnitTestSuite runs all; FxTestSupport boots JavaFX"
      ]
    }
  ]
}